# Copy to .env and fill in. Secrets only — see docs/SKILL_AUTHORING.md's
# sibling convention in AGENTS.md: everything else lives in per-instance
# config, not here.

# Model provider is AWS Bedrock, via explicit keys (not your ~/.aws
# profile — scripts/configure_instances.py copies these into each
# instance's own .env). Create an IAM user/role scoped to
# bedrock:InvokeModel / InvokeModelWithResponseStream and put its keys
# here. AWS_SESSION_TOKEN is only needed for temporary/STS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Model access to Claude on Bedrock must be enabled in that region's
# Bedrock console before first use. Override the model id (a cross-region
# inference profile id, not a bare foundation-model id) if needed:
# HERMES_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# The shared database. `npm run dev` (in web/) serves the local database on
# 127.0.0.1:5434; the dashboard and the agents' MCP server both use it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/postgres
# To use the Docker database instead (docker compose up -d), set:
# FOUNDER_AGENTS_DB=postgres
# DATABASE_URL=postgresql://founder_agents:founder_agents@localhost:5433/founder_agents

# Gateway ports, one per Hermes instance. Orchestrator is the only one the
# CLI/dashboard talks to directly.
ORCHESTRATOR_API_SERVER_PORT=8642
GROWTH_API_SERVER_PORT=8643
TECHNICAL_API_SERVER_PORT=8644
FINANCE_API_SERVER_PORT=8645
DESIGN_API_SERVER_PORT=8646

# Bearer token each instance's gateway expects, one per instance. Leave
# unset — scripts/configure_instances.py generates and persists these into
# your real .env (not this file) the first time it runs.
# ORCHESTRATOR_API_SERVER_KEY=
# GROWTH_API_SERVER_KEY=
# TECHNICAL_API_SERVER_KEY=
# FINANCE_API_SERVER_KEY=
# DESIGN_API_SERVER_KEY=
