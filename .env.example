# Copy to .env and fill in. After any change to the model lines, run:
#   python scripts/configure_instances.py && python scripts/sync_skills.py

# The model. Put in ONE provider's key; scripts/configure_instances.py uses
# the first one it finds (nvidia, gemini, openrouter, anthropic, bedrock)
# unless MODEL_PROVIDER says otherwise. MODEL is for the Orchestrator and
# the four teams, MODEL_FAST for the Reviewer (defaults to MODEL).
# python scripts/check_model.py lists the model ids your key can reach.
#
# Free, no card: build.nvidia.com (open a model, Get API Key). Development
# only: never put a real founder's confidential data through a free tier.
NVIDIA_API_KEY=
# Free backup: aistudio.google.com (Gemini Flash; the free tier may be used
# to improve Google's products).
# GEMINI_API_KEY=
# Paid: OPENROUTER_API_KEY=, ANTHROPIC_API_KEY=, or the AWS keys below.
# MODEL_PROVIDER=nvidia
# MODEL=moonshotai/kimi-k3
# MODEL_FAST=
# MODEL_PROVIDER=fake   tests the loop with harness/fake_model.py, no key

# AWS Bedrock (paid). Explicit keys, not ~/.aws. AWS_SESSION_TOKEN only for
# temporary credentials. Enable model access in the Bedrock console first.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# legro's database, for anything that reads one company directly. The
# runner and the MCP server find every company in web/.data/companies.json.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/postgres
# To use the Docker database instead (docker compose up -d), set:
# FOUNDER_AGENTS_DB=postgres
# DATABASE_URL=postgresql://founder_agents:founder_agents@localhost:5433/founder_agents

# Seconds between model calls, to stay under free-tier rate limits.
# RUNNER_MIN_GAP_SECONDS=2

# Bearer token each agent's gateway expects. Leave unset:
# scripts/configure_instances.py generates them into your real .env.
# Ports are fixed in scripts/_profiles.py (8642 to 8647).
